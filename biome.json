{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!client/build",
      "!server/dist",
      "!**/node_modules",
      "!bun.lock",
      "!docs/superpowers",
      "!.superpowers"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noGlobalIsNan": "warn",
        "noTsIgnore": "warn",
        "noUnknownAtRules": "warn",
        "noControlCharactersInRegex": "warn",
        "noArrayIndexKey": "warn"
      },
      "style": {
        "useImportType": "warn",
        "useNodejsImportProtocol": "warn",
        "noNonNullAssertion": "warn",
        "useTemplate": "warn",
        "useConst": "warn"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnusedVariables": "warn",
        "useParseIntRadix": "warn",
        "noUnusedPrivateClassMembers": "warn",
        "noEmptyPattern": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noUselessFragments": "warn",
        "useArrowFunction": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "noLabelWithoutControl": "warn",
        "useMediaCaption": "warn",
        "noAutofocus": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
