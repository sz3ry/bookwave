{
  "name": "bookwave",
  "version": "1.5.0",
  "description": "Bookwave — desktop audiobook player for Storytel",
  "repository": {
    "type": "git",
    "url": "https://github.com/sz3ry/bookwave.git"
  },
  "main": "dist/electron/main.js",
  "desktopName": "bookwave.desktop",
  "homepage": "./",
  "scripts": {
    "build:client": "bun run --filter bookwave-client build",
    "build:server": "bun run --filter bookwave-server build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "bun run build:client && bun run build:server && bun run build:electron",
    "electron:dev": "bun run build:server && bun run build:electron && cross-env NODE_ENV=development electron .",
    "electron:debug": "bun run build:server && bun run build:electron && cross-env NODE_ENV=development IS_DEBUG=true electron .",
    "dist:linux": "bun run build:all && electron-builder --linux",
    "dist:win": "bun run build:all && electron-builder --win",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && bun run --filter '*' typecheck",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist server/dist client/build",
    "check": "biome check .",
    "prepare": "husky"
  },
  "author": "Łukasz Wiśniewski <fr.luksus@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "dot-object": "^2.1.5",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.7.3"
  },
  "keywords": [
    "storytel",
    "audiobook",
    "web",
    "react",
    "express"
  ],
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@biomejs/biome": "2.6.2",
    "@types/dot-object": "^2.1.6",
    "@types/node": "^24.10.13",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.17.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "pl.sz3ry.bookwave",
    "productName": "Bookwave",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asarUnpack": [
      "server/**"
    ],
    "files": [
      "assets/**/*",
      "client/build/**/*",
      "dist/electron/**/*",
      "server/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "category": "AudioVideo;Audio;Player",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sz3ry",
        "repo": "bookwave",
        "releaseType": "release"
      }
    ]
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "client",
    "server"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": "biome check --write --no-errors-on-unmatched"
  }
}
